# ============================================
#  이 파일은 커밋합니다. 복사해서 .env 를 만들고 실제 값을 채우세요.
#     cp .env.example .env
#  .env 는 절대 커밋 금지 (.gitignore 등록됨)
# ============================================

SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- Database ---
DB_HOST=localhost
# 3306 은 다른 프로젝트가 점유하는 경우가 많아 3307 을 기본으로 씁니다.
DB_PORT=3307
DB_NAME=monsterhouse
DB_USERNAME=monster
DB_PASSWORD=monster1234
# docker-compose 용 root 비밀번호
DB_ROOT_PASSWORD=root1234

# --- 관리자 JWT (반드시 32바이트 이상) ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
JWT_ACCESS_EXP_MINUTES=30
JWT_REFRESH_EXP_DAYS=14
# 리프레시 토큰 쿠키. HTTPS 환경에서는 반드시 true.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# --- CORS (콤마 구분) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 메일 (SMTP / 추후 SES) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@monsterhouse.example
MAIL_ADMIN_TO=admin@monsterhouse.example

# --- LINE Messaging API ---
# ※ LINE Notify 는 2025-03-31 종료. Messaging API 채널 액세스 토큰을 사용.
# 미설정 시 LINE_ENABLED=false 로 두면 발송을 건너뛰고 로그만 남깁니다.
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=

# --- AWS S3 / CloudFront (갤러리) ---
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=monsterhouse-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=

# --- YouTube Data API v3 (about 페이지) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
