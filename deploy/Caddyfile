# MONSTER HOUSE 엣지 — HTTPS 자동 + 라우팅
#
# 같은 도메인에서 화면과 API 를 함께 내보내므로 CORS 문제가 없습니다.
#   /api/*, /uploads/*  → backend (Spring Boot)
#   그 외 전부          → frontend (React 정적, nginx)
#
# 인증서(Let's Encrypt)는 Caddy 가 자동 발급·갱신합니다.
# 단, 그러려면 도메인 A레코드가 이 서버 IP 로 이미 향해 있어야 합니다(챌린지 통과).

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode gzip zstd

	# API 와 업로드 이미지는 백엔드로
	@backend path /api/* /uploads/*
	handle @backend {
		reverse_proxy backend:8080
	}

	# 나머지는 프론트(nginx SPA)로
	handle {
		reverse_proxy frontend:80
	}
}
