# 복사해서 .env 로 쓰세요:  cp .env.example .env  → 값 채우기
# .env 는 절대 커밋하지 마세요 (비밀값).

# ===== 도메인 =====
SITE_DOMAIN=monsterhouse.co.kr          # 스킴 없이
SITE_ORIGIN=https://monsterhouse.co.kr  # 스킴 포함 (CORS·메일 링크용)
ACME_EMAIL=본인메일@example.com          # ⚠ 실제 이메일. Let's Encrypt 발급 알림용. example.com 금지

# ===== DB =====
DB_NAME=monsterhouse
DB_USERNAME=monster
DB_PASSWORD=여기에_강한_비밀번호            # ⚠ 반드시 변경
DB_ROOT_PASSWORD=여기에_다른_강한_비밀번호   # ⚠ 반드시 변경

# ===== 보안 =====
# 32자 이상. 아래 명령으로 생성:  openssl rand -base64 48
JWT_SECRET=여기에_openssl로_생성한_긴_문자열

# ===== 첫 관리자 계정 (최초 1회) =====
# true 로 두고 한 번 띄우면 아래 계정이 생성됩니다.
# 로그인해서 확인한 뒤, 이 값을 false 로 바꾸고 다시 배포하세요.
# ⚠ 비밀번호는 개발용(admin1234!)을 쓰지 말고 강한 값으로.
ADMIN_SEED_ENABLED=true
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=여기에_강한_관리자_비밀번호

# ===== 프론트 빌드에 박히는 공개 링크 (선택) =====
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@monsterhouse
VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@monsterhouse

# ===== 메일 발송 (선택 — 예약 확정 안내 메일) =====
# Gmail 이면 앱 비밀번호 사용. 안 쓰면 MAIL_ENABLED=false 로 두세요.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_ADMIN_TO=

# ===== LINE 알림 (선택 — 일본 고객 문의) =====
LINE_ENABLED=false
LINE_CHANNEL_TOKEN=
LINE_ADMIN_USER_ID=
